syntax = "proto3";

// IMPORTANT: the proto `package` is part of the wire method name (e.g. "consumer.ExampleService/getById"),
// so it MUST be the same as the server's proto package, otherwise calls fail with UNIMPLEMENTED.
// Only java_package must differ, so the generated classes don't collide with a local gRPC entry point.
package consumer;

option java_multiple_files = true;
option java_package = "{{package}}.grpc.consumer";
option java_outer_classname = "ExampleServiceProto";

// Example gRPC Service for client consumption
// TODO: Replace this with the actual service definition from the server you want to consume.
// The proto file should match the server's proto definition.
service ExampleService {
  // Get resource by ID
  rpc getById(Request) returns (Response);
}

message Request {
  string id = 1;
}

message Response {
  string id = 1;
  string message = 2;
}
