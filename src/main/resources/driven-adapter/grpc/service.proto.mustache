syntax = "proto3";

// IMPORTANT: the proto `package` and `service` name are part of the wire method name
// (e.g. "grpc.CustomService/getById"), so they MUST match the server's proto, otherwise
// calls fail with UNIMPLEMENTED. The defaults match the gRPC entry point generated by this
// plugin (gep --type grpc). Only java_package differs, so the generated classes don't collide.
package grpc;

option java_multiple_files = true;
option java_package = "{{package}}.grpc.consumer";
option java_outer_classname = "CustomServiceProto";

// Example gRPC Service for client consumption
// TODO: Replace this with the actual service definition from the server you want to consume.
// A client may declare only the methods it calls.
service CustomService {
  // Get resource by ID
  rpc getById(Request) returns (Response);
}

message Request {
  string id = 1;
}

message Response {
  string id = 1;
  string message = 2;
}
