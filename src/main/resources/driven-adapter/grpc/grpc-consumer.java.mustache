package {{package}}.grpc.consumer;

import {{package}}.grpc.consumer.ExampleServiceGrpc;
import io.grpc.StatusRuntimeException;
{{#lombok}}
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
{{/lombok}}
{{^lombok}}
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
{{/lombok}}
import org.springframework.stereotype.Service;

/**
 * gRPC Consumer Adapter.
 *
 * <p>Consumes an external gRPC service through the blocking stub generated by the
 * protobuf-gradle-plugin from {@code src/main/proto/consumer.proto}
 * ({@code ./gradlew generateProto}).</p>
 *
 * @see <a href="https://docs.spring.io/spring-boot/reference/io/grpc.html">Spring Boot gRPC</a>
 */
{{#lombok}}
@Slf4j
{{/lombok}}
@Service
{{#lombok}}
@RequiredArgsConstructor
{{/lombok}}
public class GrpcConsumerAdapter // implements Gateway from domain
{
    {{^lombok}}
    private static final Logger log = LoggerFactory.getLogger(GrpcConsumerAdapter.class);
    {{/lombok}}

    private final ExampleServiceGrpc.ExampleServiceBlockingStub exampleServiceStub;
    {{^lombok}}

    public GrpcConsumerAdapter(ExampleServiceGrpc.ExampleServiceBlockingStub exampleServiceStub) {
        this.exampleServiceStub = exampleServiceStub;
    }
    {{/lombok}}

    /**
     * Example method to call a remote gRPC service.
     *
     * <p>TODO: Replace this sample implementation with your business logic.</p>
     *
     * @param id the identifier to send in the request
     * @return the response message from the gRPC server
     */
    public String getById(String id) {
        log.debug("Calling gRPC service with id: {}", id);
        try {
            Request request = Request.newBuilder()
                    .setId(id)
                    .build();
            return exampleServiceStub.getById(request).getMessage();
        } catch (StatusRuntimeException e) {
            // Log only the status: the payload may contain sensitive data
            log.error("gRPC call failed with status: {}", e.getStatus().getCode());
            throw new IllegalStateException("Failed to call gRPC service", e);
        }
    }
}
