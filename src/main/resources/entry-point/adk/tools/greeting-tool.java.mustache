package {{package}}.adk.tools;

import com.google.adk.tools.Annotations.Schema;
import com.google.adk.tools.Annotations.Tool;

public class GreetingTool {

    @Tool(description = "Greets a user by name")
    public String greet(@Schema(description = "The name of the user to greet") String name) {
        if (name == null || name.isBlank()) {
            return "Hello! Please tell me your name.";
        }
        return "Hello, " + name + "! Welcome.";
    }
}
