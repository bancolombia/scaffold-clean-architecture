package {{package}}.adk.adapter;

import com.google.adk.events.Event;
import com.google.adk.runner.InMemoryRunner;
import com.google.adk.sessions.Session;
import com.google.genai.types.Content;
import com.google.genai.types.Part;
import {{package}}.model.adk.gateways.AdkAgentGateway;
{{#lombok}}
import lombok.RequiredArgsConstructor;
{{/lombok}}
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
{{#lombok}}
@RequiredArgsConstructor
{{/lombok}}
public class AdkAgentAdapter implements AdkAgentGateway {

    private final InMemoryRunner runner;

{{^lombok}}
    public AdkAgentAdapter(InMemoryRunner runner) {
        this.runner = runner;
    }
{{/lombok}}

    @Override
    public Mono<String> chat(String userId, String message) {
        return Mono.fromCallable(() -> {
            Session session = runner.sessionService()
                    .createSession(runner.appName(), userId)
                    .blockingGet();
            Content userMsg = Content.fromParts(Part.fromText(message));
            StringBuilder response = new StringBuilder();
            runner.runAsync(session.userId(), session.id(), userMsg)
                    .blockingForEach(event -> {
                        String text = event.stringifyContent();
                        if (text != null && !text.isEmpty()) {
                            response.append(text);
                        }
                    });
            return response.toString();
        });
    }
}
