{{#lombok}}
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@Builder(toBuilder = true)
@NoArgsConstructor
@AllArgsConstructor
{{/lombok}}
public class AdkChatRequest {
    private String userId;
    private String message;
{{^lombok}}

    public AdkChatRequest() {
    }

    public AdkChatRequest(String userId, String message) {
