{{/lombok}}

    // Schema validation against Apicurio Registry happens before this handler runs.
    // An invalid record never reaches this method; see:
    // https://bancolombia.github.io/reactive-commons-java/docs/reactive-commons/configuration_properties/kafka-schema-validation
    public Mono<Void> handleMessage(RawMessage message) {
        KafkaMessage rawMessage = (KafkaMessage) message;
        log.info("Message received from topic: " + new String(rawMessage.getBody()));
        log.info("Headers: " + rawMessage.getProperties().getHeaders());
        // Process the message
        return Mono.empty();
    }
}
