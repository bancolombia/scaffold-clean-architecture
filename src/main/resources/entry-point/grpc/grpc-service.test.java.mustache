package {{package}}.grpc;

import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;

import {{package}}.grpc.mapper.ErrorMapper;
import io.grpc.stub.StreamObserver;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

@ExtendWith(MockitoExtension.class)
class GrpcServerEntryPointTest {

    @Mock
    private ErrorMapper errorMapper;

    private GrpcServerEntryPoint grpcServerEntryPoint;

    @BeforeEach
    void setUp() {
        grpcServerEntryPoint = new GrpcServerEntryPoint(errorMapper);
    }

    @Test
    void shouldProcessGetByIdRequest() {
        // Arrange
        Request request = Request.newBuilder()
                .setId("test-id")
                .build();
        @SuppressWarnings("unchecked")
        StreamObserver<Response> responseObserver = mock(StreamObserver.class);

        // Act
        assertDoesNotThrow(() -> grpcServerEntryPoint.getById(request, responseObserver));

        // Assert
        verify(responseObserver).onNext(any(Response.class));
        verify(responseObserver).onCompleted();
    }

    @Test
    void shouldReturnHealthStatus() {
        // Arrange
        com.google.protobuf.Empty request = com.google.protobuf.Empty.getDefaultInstance();
        @SuppressWarnings("unchecked")
        StreamObserver<HealthResponse> responseObserver = mock(StreamObserver.class);

        // Act
        assertDoesNotThrow(() -> grpcServerEntryPoint.health(request, responseObserver));

        // Assert
        verify(responseObserver).onNext(any(HealthResponse.class));
        verify(responseObserver).onCompleted();
    }
}